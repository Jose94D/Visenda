<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: excluye todo de la copia en la nube y de la transferencia entre dispositivos.
     El traspaso a otro teléfono se hace solo con el respaldo cifrado de la app. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
